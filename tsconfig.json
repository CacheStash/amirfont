{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": [
      "node",
      "@cloudflare/workers-types",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "index.js",
    "index.tsx",
    "App.tsx",
    "fonts.d.ts",
    "pages/**/*",
    "components/**/*",
    "app/**/*",
    "lib/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}